# Clarafin Local Environment Template (Safe to Commit & Push)
# Copy values into `.env` (gitignored) and fill in real API keys/secrets locally.

# --- Core Backend Service (services/api) ---
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=debug
ENABLE_DEV_AUTH=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- PostgreSQL & Redis (Local Docker Compose Defaults) ---
POSTGRES_USER=clarafin
POSTGRES_PASSWORD=clarafin_dev_password
POSTGRES_DB=clarafin
POSTGRES_PORT=5432
DATABASE_URL=postgresql://clarafin:clarafin_dev_password@localhost:5432/clarafin?sslmode=disable
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Google Gemini AI (Clarafin AI Chatbot) ---
# Model routing, fallbacks, and timeouts are managed in services/api/internal/config/gemini_policy.go.
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
AI_RATE_LIMIT_PER_MIN=10

# --- Supabase Auth & JWT ---
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_JWT_SECRET=<YOUR_SUPABASE_JWT_SECRET>
DEV_JWT_SECRET=<DEV_ONLY_HS256_SECRET_MIN_32_CHARS>

# --- Optional Integrations (Wave P4: Gmail OAuth, Xendit QRIS, Google Meet) ---
GMAIL_TOKEN_ENCRYPTION_KEY=<BASE64_32_BYTE_AES256_KEY>
GOOGLE_OAUTH_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_OAUTH_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
XENDIT_SECRET_KEY=<YOUR_XENDIT_SECRET_KEY>
XENDIT_CALLBACK_TOKEN=<YOUR_XENDIT_CALLBACK_TOKEN>

# --- Flutter Mobile (apps/mobile --dart-define) ---
# Android emulator uses http://10.0.2.2:8080; iOS simulator/desktop uses http://localhost:8080
CLARAFIN_API_BASE_URL=http://10.0.2.2:8080
