# Clarafin Backend Service Environment Template (Safe to Commit)
# Copy values into `.env` (gitignored) and supply local secrets before starting.

# --- Core Server ---
APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=debug
ENABLE_DEV_AUTH=true
DEV_JWT_SECRET=<DEV_ONLY_HS256_SECRET_MIN_32_CHARS>
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- PostgreSQL & Redis (Host & Docker Compose Defaults) ---
POSTGRES_USER=clarafin
POSTGRES_PASSWORD=clarafin_dev_password
POSTGRES_DB=clarafin
POSTGRES_PORT=5432
DATABASE_URL=postgresql://clarafin:clarafin_dev_password@localhost:5432/clarafin?sslmode=disable
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Optional overrides used only when running the api container against external DB/Redis:
# DOCKER_DATABASE_URL=postgresql://clarafin:clarafin_dev_password@postgres:5432/clarafin?sslmode=disable
# DOCKER_REDIS_URL=redis://redis:6379/0

# --- Supabase Auth & JWT ---
SUPABASE_URL=http://localhost:54321
SUPABASE_JWT_SECRET=<YOUR_SUPABASE_JWT_SECRET>
SUPABASE_JWKS_URL=

# --- Google Gemini AI ---
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite-preview,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.8-flash
GEMINI_CONTEXT_CACHE_ENABLED=true
AI_RATE_LIMIT_PER_MIN=10

# --- Optional Integrations (Wave P4) ---
GMAIL_TOKEN_ENCRYPTION_KEY=<BASE64_32_BYTE_AES256_KEY>
GOOGLE_OAUTH_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_OAUTH_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
XENDIT_SECRET_KEY=<YOUR_XENDIT_SECRET_KEY>
XENDIT_CALLBACK_TOKEN=<YOUR_XENDIT_CALLBACK_TOKEN>
